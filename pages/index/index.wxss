page { background: #F7F3EA; }
.cover {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  padding-top: 18vh;
  background: linear-gradient(180deg, #F7F3EA 0%, #EBDDC3 100%);
}
.seal {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  text-align: center; font-size: 64rpx; color: #fff;
  background: #8C2F39; border-radius: 12rpx;
  transform: rotate(-6deg);
}
.title { margin-top: 60rpx; font-size: 68rpx; font-weight: bold; color: #3A2A22; letter-spacing: 12rpx; }
.subtitle { margin-top: 20rpx; font-size: 30rpx; color: #8C2F39; letter-spacing: 6rpx; }
.line { width: 120rpx; height: 4rpx; background: #8C2F39; margin: 50rpx 0; }
.desc { font-size: 28rpx; color: #6B5B4E; text-align: center; line-height: 52rpx; white-space: pre-line; }
.enter-btn {
  margin-top: 100rpx; width: 320rpx;
  background: #8C2F39; color: #fff; border-radius: 50rpx; font-size: 32rpx;
}